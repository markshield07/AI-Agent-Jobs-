# Where the SQLite file, uploaded resumes and generated files live. Defaults to ./data
JOBAGENT_DATA_DIR=./data

# How model calls are made:
#   auto        use the API if ANTHROPIC_API_KEY is set, else the `claude` command line
#   claude-code always use `claude -p` on your Claude subscription login (no key needed)
#   api         always use the API (needs ANTHROPIC_API_KEY)
JOBAGENT_LLM_BACKEND=auto

# Only needed for the API backend.
# ANTHROPIC_API_KEY=sk-ant-...

# Model for the API backend.
JOBAGENT_MODEL=claude-opus-5

# Optional model override for the claude-code backend, e.g. sonnet or opus.
# JOBAGENT_CLAUDE_CODE_MODEL=sonnet

# --- Submission (phase 4) ---
# dry_run fills every form and stops at the button; review parks it for your
# approval; auto submits. Nothing is sent until you change this.
JOBAGENT_APPLY_MODE=dry_run
# Submissions in any trailing 24 hours, and LinkedIn's and Indeed's own caps
# inside that. LinkedIn and Indeed sign-ins are not set here: run
# `jobagent login linkedin` (or indeed) once. No password goes in this file.
JOBAGENT_DAILY_APPLY_CAP=20
JOBAGENT_EASY_APPLY_DAILY_CAP=10

# --- Response tracking (phase 5) ---
# The mailbox the agent reads replies from. It is opened read-only: nothing is
# sent, moved, deleted or marked read. Leave these unset and `jobagent inbox`
# tells you so instead of doing anything.
# JOBAGENT_IMAP_HOST=imap.gmail.com
# JOBAGENT_IMAP_PORT=993
# JOBAGENT_IMAP_USER=you@example.com
# For Gmail and Outlook this is an app password, not your account password.
# JOBAGENT_IMAP_PASSWORD=
# A dedicated folder, if you filter application mail into one.
# JOBAGENT_IMAP_FOLDER=INBOX

# How far back the first poll reads. Later polls start at the newest mail on file.
JOBAGENT_INBOX_LOOKBACK_DAYS=30

# Ask the model about replies the phrase rules cannot read.
JOBAGENT_INBOX_MODEL_TRIAGE=true

# Below this confidence a reply is logged but moves no status.
JOBAGENT_INBOX_MIN_CONFIDENCE=0.6
